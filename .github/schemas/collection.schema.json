{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notebooks.dandiarchive.org/schemas/collection.schema.json",
  "title": "Notebook registry collection (collections/<name>.yaml)",
  "description": "A curated group of entries (an archive, journal, course, ...). Curators approve entries joining it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "curators"],
  "properties": {
    "name": {
      "description": "Must match the file name without .yaml.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "homepage": {"type": "string", "format": "uri"},
    "curators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
      },
      "uniqueItems": true
    },
    "featured": {
      "description": "Entry names tested in every weekly sweep regardless of recent activity.",
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
      "uniqueItems": true
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_related_prefix": {
          "description": "Entries must reference at least one resource with one of these prefixes.",
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}
        },
        "guidelines": {"type": "string", "format": "uri"}
      }
    }
  }
}
